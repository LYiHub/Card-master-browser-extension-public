{
  "name": "card-master",
  "version": "0.2.0",
  "description": "以游戏化卡牌统一管理用户脚本与网页能力：AI 创建脚本、新标签页、内容过滤、暗夜降临、媒体控制、视频增强与游戏手柄交互。",
  "private": true,
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LYiHub/Card-master-browser-extension-public.git"
  },
  "homepage": "https://github.com/LYiHub/Card-master-browser-extension-public#readme",
  "bugs": {
    "url": "https://github.com/LYiHub/Card-master-browser-extension-public/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.18.0",
  "type": "module",
  "scripts": {
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write --error-on-warnings .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "secrets:check": "node scripts/check-secrets.mjs",
    "extension:package": "node scripts/package-extensions.mjs",
    "extension:zip": "node scripts/package-chromium-zip.mjs",
    "release:package": "node scripts/package-release.mjs",
    "release:package:preview": "node scripts/package-release.mjs --allow-unnotarized-safari",
    "ship": "node scripts/check-commit-push.mjs"
  },
  "dependencies": {
    "@adguard/extended-css": "2.2.0",
    "@adguard/tswebextension": "5.0.0",
    "acorn": "8.17.0",
    "gsap": "3.15.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "spatial-nav-css": "file:vendor/spatial-nav-css",
    "tldts": "7.4.9"
  },
  "devDependencies": {
    "@adguard/dnr-rulesets": "5.0.1",
    "@biomejs/biome": "^2.5.3",
    "@types/chrome": "^0.2.2",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^5.1.3",
    "esbuild": "0.27.7",
    "sharp": "^0.35.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.3",
    "vitest": "^4.1.10"
  }
}
